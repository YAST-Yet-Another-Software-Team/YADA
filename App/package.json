    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "prettier-plugin-svelte": "^3.3.3",
    "socket.io": "^4.8.1",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.1.0",
    "wrangler": "^4.118.0"
  },
