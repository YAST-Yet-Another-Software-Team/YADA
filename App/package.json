{
  "name": "yada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy --keep-vars",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright install && playwright test",
    "test": "npm run test:e2e"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/infra": "^0.3.7",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sveltejs/kit": "^2.69.3",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "socket.io-client": "^4.8.3",
    "svelte": "^5.0.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.5",
