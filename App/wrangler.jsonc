{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yada",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-04",
  // Better Auth and Drizzle both pull Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // No always-on Node process on Workers, so Socket.IO cannot attach. Tracking
    // falls back to the existing GET /api/trips poll. Leave this `true` locally,
    // where vite-plugin-socket-io does attach one.
    "REALTIME_ENABLED": "false",
    // Must exactly match the origin the browser uses, or sign-ins appear to
    // succeed and then don't stick.
    "BETTER_AUTH_URL": "https://yada.flaviosobbin04.workers.dev",
    "SOCKET_CORS_ORIGIN": "https://yada.flaviosobbin04.workers.dev",
    // The From on confirmation and password-reset mail. Must be an address
    // *verified as a sender* in Brevo — it emails you a link to click. Not a
    // domain: this deployment is on a workers.dev subdomain with no DNS of its
    // own, which is the whole reason the provider is Brevo. See
    // $lib/server/email/brevo.
    "EMAIL_FROM": "fnbsobbin@st.knust.edu.gh",
    "EMAIL_FROM_NAME": "YADA"
  }
}
