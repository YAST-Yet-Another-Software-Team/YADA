{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yada",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    // No always-on Node process on Workers, so Socket.IO cannot attach. Tracking
    // falls back to the existing GET /api/trips poll. Leave this `true` locally,
    // where vite-plugin-socket-io does attach one.
    "REALTIME_ENABLED": "false",
  }
}
