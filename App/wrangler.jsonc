{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yada",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-04",
  // Better Auth and Drizzle both pull Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // No always-on Node process on Workers, so Socket.IO cannot attach. Tracking
    // falls back to the existing GET /api/trips poll. Leave this `true` locally,
    // where vite-plugin-socket-io does attach one.
    "REALTIME_ENABLED": "false",
    // Must exactly match the origin the browser uses, or sign-ins appear to
    // succeed and then don't stick. Update after the first deploy tells you the
    // workers.dev subdomain.
    "BETTER_AUTH_URL": "https://yada.workers.dev"
  }
  // Secrets (never in this file): DATABASE_URL — the Neon *pooled* string,
  // BETTER_AUTH_SECRET, GOOGLE_MAPS_API_KEY, GOOGLE_MAPS_MAP_ID,
  // OAUTH_GOOGLE_CLIENT_ID, OAUTH_GOOGLE_CLIENT_SECRET.
  // Set with: wrangler secret put <NAME>
}
